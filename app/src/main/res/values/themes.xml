        <item name="colorPrimary">@color/yetti_primary</item>
        <item name="colorPrimaryVariant">@color/yetti_primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/yetti_accent</item>
        <item name="colorSecondaryVariant">@color/yetti_accent</item>
        <item name="colorOnSecondary">@color/white</item>
