<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="@drawable/behance_card_bg"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Standalone App Logo (nextlvl.png - NO CIRCLE) -->
    <ImageView
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:contentDescription="@string/nextlvl_logo_desc"
        android:scaleType="fitStart"
        android:src="@drawable/nextlvl" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/blockhead"
        android:letterSpacing="0.06"
        android:text="Enraged Yetti"
        android:textColor="@color/solar_lime"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>