<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Global App Background (bckground.jpg) -->
    <ImageView
        android:id="@+id/appBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bckground"
        android:contentDescription="@string/app_background_desc" />

    <!-- Darkened App Background Overlay (80% Dark Layer for High-Contrast Neon Glass) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC030408" />

    <!-- Top Navigation Header Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0000000"
        android:fitsSystemWindows="true"
        app:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Top Left Circular Glowing Logo (nextlvl.png) -->
            <FrameLayout
                android:id="@+id/btnHeaderLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/glowing_circle_logo"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/nextlvl_logo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/nextlvl" />
            </FrameLayout>

            <!-- Horizontal Scrollable Navigation Pills -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavHome"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/nav_pill_button_selector"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="Home"
                        android:textColor="@color/nav_pill_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavAbout"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/nav_pill_button_selector"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="About"
                        android:textColor="@color/nav_pill_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavProducts"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/nav_pill_button_selector"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="Products"
                        android:textColor="@color/nav_pill_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavContact"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/nav_pill_button_selector"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="Contact"
                        android:textColor="@color/nav_pill_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavEnquiry"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/nav_pill_button_selector"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="Enquiry"
                        android:textColor="@color/nav_pill_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <!-- Account / Sign In Pill (Default Sign In for fresh user flow) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavProfile"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/nav_pill_button_selector"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="0dp"
                        android:text="Sign In"
                        android:textColor="@color/nav_pill_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavCart"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/nav_pill_button_selector"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="Cart"
                        android:textColor="@color/nav_pill_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>