<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Main Screen Content Coordinator Layout -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Global App Background (bckground.jpg) -->
        <ImageView
            android:id="@+id/appBackgroundImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bckground"
            android:contentDescription="@string/app_background_desc" />

        <!-- Crisp Deep Obsidian Background Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E00B0E14" />

        <!-- Crisp Top Navigation Header Bar (#0B0E14) -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF0B0E14"
            android:fitsSystemWindows="true"
            app:elevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="#FF0B0E14"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <!-- Hamburger Menu Icon Button (☰) -->
                <ImageView
                    android:id="@+id/btnHamburgerMenu"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:contentDescription="@string/app_name"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_hamburger"
                    app:tint="#80FFFFFF" />

                <!-- Standalone App Logo (nextlvl.png - NO CIRCLE, NO BOX) -->
                <ImageView
                    android:id="@+id/btnHeaderLogo"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="@string/nextlvl_logo_desc"
                    android:focusable="true"
                    android:scaleType="fitStart"
                    android:src="@drawable/nextlvl" />

                <!-- Notification Bell Icon with Red Dot -->
                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_notification_bell"
                        app:tint="#80FFFFFF" />

                    <!-- Glowing Red Dot -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/glass_badge_background"
                        android:backgroundTint="#FF3333" />
                </FrameLayout>

            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Main Nav Host Content -->
        <include layout="@layout/content_main" />

        <!-- Crisp Bottom Navigation Bar matching Behance UI Layout -->
        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="bottom"
            android:background="#F50D1118"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- 1. Home Tab -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTabHomeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_nav_home"
                    app:tint="#00FF66" />
            </LinearLayout>

            <!-- 2. Products Tab -->
            <LinearLayout
                android:id="@+id/tabProducts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTabProductsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/app_name"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="#80FFFFFF" />
            </LinearLayout>

            <!-- 3. Cart Tab -->
            <LinearLayout
                android:id="@+id/tabCart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTabCartIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_nav_cart"
                    app:tint="#80FFFFFF" />
            </LinearLayout>

            <!-- 4. Profile / Sign In Tab -->
            <LinearLayout
                android:id="@+id/tabProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTabProfileIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="#80FFFFFF" />
            </LinearLayout>

        </LinearLayout>

        <!-- Opening Phase-In Splash Screen Overlay (Black Screen + Standalone Logo + Solar Lime Text) -->
        <FrameLayout
            android:id="@+id/splashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:clickable="true"
            android:elevation="100dp"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Standalone Logo Frame (NO CIRCLE, NO BOX) -->
                <ImageView
                    android:id="@+id/splashLogo"
                    android:layout_width="220dp"
                    android:layout_height="90dp"
                    android:contentDescription="@string/nextlvl_logo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/nextlvl" />

                <!-- Solar Lime Text: "Enraged Yetti" in Blockhead Typography -->
                <TextView
                    android:id="@+id/splashText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/blockhead"
                    android:letterSpacing="0.08"
                    android:text="Enraged Yetti"
                    android:textColor="@color/solar_lime"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer (Hamburger Menu with ALL Pages) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FF0A0C14"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main"
        app:itemIconTint="#00FF66"
        app:itemTextColor="@color/white"
        app:menu="@menu/activity_main_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>