<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Global App Background (bckground.jpg) -->
    <ImageView
        android:id="@+id/appBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bckground"
        android:contentDescription="@string/app_background_desc" />

    <!-- Darkened App Background Overlay (80% Dark Layer) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC030408" />

    <!-- Top Navigation Header Bar Matching Screenshot -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0000000"
        android:fitsSystemWindows="true"
        app:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- Top Left Logo -->
            <FrameLayout
                android:id="@+id/btnHeaderLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/glowing_circle_logo"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/nextlvl_logo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/nextlvl" />
            </FrameLayout>

            <!-- Header Navigation Tabs Matching Screenshot -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1. Home Tab -->
                <LinearLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/ivTabHomeIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_nav_home"
                        app:tint="#00FF66" />

                    <TextView
                        android:id="@+id/tvTabHomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Home"
                        android:textColor="#00FF66"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. Wallet / Cart Tab -->
                <LinearLayout
                    android:id="@+id/tabCart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/ivTabCartIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_nav_cart"
                        app:tint="#80FFFFFF" />

                    <TextView
                        android:id="@+id/tvTabCartText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Cart"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 3. Orders / History Tab -->
                <LinearLayout
                    android:id="@+id/tabOrders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/ivTabOrdersIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_nav_history"
                        app:tint="#80FFFFFF" />

                    <TextView
                        android:id="@+id/tvTabOrdersText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Orders"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 4. Profile / Sign In Tab -->
                <LinearLayout
                    android:id="@+id/tabProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/ivTabProfileIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="#80FFFFFF" />

                    <TextView
                        android:id="@+id/tvTabProfileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Sign In"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>