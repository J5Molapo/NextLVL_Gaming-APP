<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Section 8: Become a Yetti Member / Sign In Card -->
        <LinearLayout
            android:id="@+id/cardSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/glass_card_highlighted"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="visible">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/glowing_circle_logo"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/nextlvl_logo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/nextlvl" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Become a Yetti Member"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Sign up with your email or Phone number"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Contact Method Selection Box (Tap to toggle Email / Phone) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etContactMethodLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contact method (Tap to toggle Email/Phone)"
                app:boxBackgroundMode="none"
                app:hintAnimationEnabled="true"
                app:hintTextColor="#00FF66"
                android:textColorHint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactMethod"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_input_selector"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true"
                    android:text="Email"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Account Contact Input Field (Changes dynamically) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etEmailLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Email address"
                app:boxBackgroundMode="none"
                app:hintAnimationEnabled="true"
                app:hintTextColor="#00FF66"
                android:textColorHint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_input_selector"
                    android:gravity="center_vertical"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueSignUp"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:layout_gravity="start"
                android:layout_marginTop="16dp"
                android:background="@drawable/glow_button_green"
                android:text="Continue"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="#30FFFFFF" />

            <!-- Existing Account Login Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="Already have an account?"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Email or Phone number"
                app:boxBackgroundMode="none"
                app:hintAnimationEnabled="true"
                app:hintTextColor="#00FF66"
                android:textColorHint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_input_selector"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Password"
                app:boxBackgroundMode="none"
                app:hintAnimationEnabled="true"
                app:hintTextColor="#00FF66"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#00FF66"
                android:textColorHint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_input_selector"
                    android:gravity="center_vertical"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/glow_button_green"
                android:text="Sign In"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/btnGotoChooseUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Need a username? Create Account →"
                android:textColor="#00FF66"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Section 4: Choose a Username Card -->
        <LinearLayout
            android:id="@+id/cardChooseUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/glass_card_highlighted"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/glowing_circle_logo"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/nextlvl_logo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/nextlvl" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Choose a Username"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="Create a unique username for your Yetti account"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                app:boxBackgroundMode="none"
                app:hintAnimationEnabled="true"
                app:hintTextColor="#00FF66"
                android:textColorHint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChooseUsername"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_input_selector"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Password"
                app:boxBackgroundMode="none"
                app:hintAnimationEnabled="true"
                app:hintTextColor="#00FF66"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#00FF66"
                android:textColorHint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChoosePassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_input_selector"
                    android:gravity="center_vertical"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateAccount"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="160dp"
                android:layout_height="46dp"
                android:layout_gravity="start"
                android:layout_marginTop="24dp"
                android:background="@drawable/glow_button_green"
                android:text="Create account"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/btnBackToSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="← Back to Sign In"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>