<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused / Clicked state: Glowing neon green border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#35000000" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#00FF66" />
        </shape>
    </item>
    <!-- Normal unfocused state: Clean subtle glass border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#25000000" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#35FFFFFF" />
        </shape>
    </item>
</selector>