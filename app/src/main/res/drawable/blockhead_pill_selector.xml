<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state: Glowing gaming green -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FF66" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#00FF66" />
        </shape>
    </item>
    <!-- Pressed state: Glowing gaming green -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FF66" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Normal state: Dark obsidian pill with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181D28" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>